{
  "opencollection": "1.0.0",
  "info": {
    "name": "Toloka Assignments Operations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Operations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the list of operations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.toloka.ai/api/v1/operations",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results per page."
              }
            ]
          },
          "docs": "Get the list of operations"
        },
        {
          "info": {
            "name": "Get an operation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.toloka.ai/api/v1/operations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Object identifier."
              }
            ]
          },
          "docs": "Poll the status of an asynchronous operation."
        }
      ]
    }
  ],
  "bundled": true
}